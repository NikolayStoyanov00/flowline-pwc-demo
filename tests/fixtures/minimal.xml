<?xml version="1.0" encoding="Windows-1252"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  A complete but tiny PowerCenter export: one source, one target, one mapping,
  four steps, nine connectors. The real export has 142 instances and 1,066
  connectors, which is too much to follow in a debugger; this is the same shape
  at a size you can step through end to end in a few minutes.

      RAW_ITEMS > SQ_RAW_ITEMS > EXP_ITEMS > STG_ITEMS

  Converts to exactly one dbt model. See docs/REVIEW.md for how to walk it
  through in a debugger.
-->
<POWERMART CREATION_DATE="01/01/2026 00:00:00" REPOSITORY_VERSION="187.96">
<REPOSITORY NAME="REPO_Minimal" VERSION="187" CODEPAGE="MS1252" DATABASETYPE="Oracle">
<FOLDER NAME="MINIMAL" OWNER="DEV" SHARED="SHARED" PERMISSIONS="rwx---r--">

    <SOURCE DATABASETYPE ="Oracle" DBDNAME ="XEPDB1_RAW" NAME ="RAW_ITEMS" OWNERNAME ="RAW" VERSIONNUMBER ="1">
        <SOURCEFIELD DATATYPE ="varchar2" FIELDNUMBER ="1" KEYTYPE ="PRIMARY KEY" NAME ="ID" NULLABLE ="NOTNULL" PRECISION ="100" SCALE ="0"/>
        <SOURCEFIELD DATATYPE ="varchar2" FIELDNUMBER ="2" KEYTYPE ="NOT A KEY" NAME ="SKU" NULLABLE ="NULL" PRECISION ="50" SCALE ="0"/>
        <SOURCEFIELD DATATYPE ="number" FIELDNUMBER ="3" KEYTYPE ="NOT A KEY" NAME ="QTY" NULLABLE ="NULL" PRECISION ="15" SCALE ="0"/>
    </SOURCE>

    <TARGET DATABASETYPE ="Oracle" NAME ="STG_ITEMS" VERSIONNUMBER ="1">
        <TARGETFIELD DATATYPE ="varchar2" FIELDNUMBER ="1" KEYTYPE ="NOT A KEY" NAME ="ITEM_ID" NULLABLE ="NULL" PRECISION ="100" SCALE ="0"/>
        <TARGETFIELD DATATYPE ="varchar2" FIELDNUMBER ="2" KEYTYPE ="NOT A KEY" NAME ="PRODUCT_ID" NULLABLE ="NULL" PRECISION ="50" SCALE ="0"/>
        <TARGETFIELD DATATYPE ="number" FIELDNUMBER ="3" KEYTYPE ="NOT A KEY" NAME ="QUANTITY" NULLABLE ="NULL" PRECISION ="15" SCALE ="0"/>
        <TARGETFIELD DATATYPE ="number" FIELDNUMBER ="4" KEYTYPE ="NOT A KEY" NAME ="IS_BULK" NULLABLE ="NULL" PRECISION ="10" SCALE ="0"/>
    </TARGET>

    <MAPPING ISVALID ="YES" NAME ="m_MINIMAL" OBJECTVERSION ="1" VERSIONNUMBER ="1">

        <TRANSFORMATION NAME ="SQ_RAW_ITEMS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Source Qualifier" VERSIONNUMBER ="1">
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="ID" PORTTYPE ="INPUT/OUTPUT" PRECISION ="100" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="SKU" PORTTYPE ="INPUT/OUTPUT" PRECISION ="50" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="number" NAME ="QTY" PORTTYPE ="INPUT/OUTPUT" PRECISION ="15" SCALE ="0"/>
            <TABLEATTRIBUTE NAME ="Sql Query" VALUE =""/>
            <TABLEATTRIBUTE NAME ="Source Filter" VALUE =""/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME ="EXP_ITEMS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="1">
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="ID_IN" PORTTYPE ="INPUT" PRECISION ="100" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="SKU_IN" PORTTYPE ="INPUT" PRECISION ="50" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="number" NAME ="QTY_IN" PORTTYPE ="INPUT" PRECISION ="15" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="varchar2" EXPRESSION ="ID_IN" EXPRESSIONTYPE ="GENERAL" NAME ="ITEM_ID" PORTTYPE ="OUTPUT" PRECISION ="100" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="varchar2" EXPRESSION ="SKU_IN" EXPRESSIONTYPE ="GENERAL" NAME ="PRODUCT_ID" PORTTYPE ="OUTPUT" PRECISION ="50" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="number" EXPRESSION ="v_QTY" EXPRESSIONTYPE ="GENERAL" NAME ="QUANTITY" PORTTYPE ="OUTPUT" PRECISION ="15" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="number" EXPRESSION ="IIF(v_QTY &gt; 10, 1, 0)" EXPRESSIONTYPE ="GENERAL" NAME ="IS_BULK" PORTTYPE ="OUTPUT" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="number" EXPRESSION ="IIF(ISNULL(QTY_IN), 0, QTY_IN)" EXPRESSIONTYPE ="GENERAL" NAME ="v_QTY" PORTTYPE ="LOCAL VARIABLE" PRECISION ="15" SCALE ="0"/>
            <TABLEATTRIBUTE NAME ="Tracing Level" VALUE ="Normal"/>
        </TRANSFORMATION>

        <INSTANCE DBDNAME ="XEPDB1_RAW" NAME ="RAW_ITEMS" TRANSFORMATION_NAME ="RAW_ITEMS" TRANSFORMATION_TYPE ="Source Definition" TYPE ="SOURCE"/>
        <INSTANCE NAME ="SQ_RAW_ITEMS" REUSABLE ="NO" TRANSFORMATION_NAME ="SQ_RAW_ITEMS" TRANSFORMATION_TYPE ="Source Qualifier" TYPE ="TRANSFORMATION">
            <ASSOCIATED_SOURCE_INSTANCE NAME ="RAW_ITEMS"/>
        </INSTANCE>
        <INSTANCE NAME ="EXP_ITEMS" REUSABLE ="NO" TRANSFORMATION_NAME ="EXP_ITEMS" TRANSFORMATION_TYPE ="Expression" TYPE ="TRANSFORMATION"/>
        <INSTANCE NAME ="STG_ITEMS" TRANSFORMATION_NAME ="STG_ITEMS" TRANSFORMATION_TYPE ="Target Definition" TYPE ="TARGET">
            <TABLEATTRIBUTE NAME ="Pre SQL" VALUE ="TRUNCATE TABLE STG.STG_ITEMS"/>
        </INSTANCE>

        <CONNECTOR FROMFIELD ="ID" FROMINSTANCE ="RAW_ITEMS" FROMINSTANCETYPE ="Source Definition" TOFIELD ="ID" TOINSTANCE ="SQ_RAW_ITEMS" TOINSTANCETYPE ="Source Qualifier"/>
        <CONNECTOR FROMFIELD ="SKU" FROMINSTANCE ="RAW_ITEMS" FROMINSTANCETYPE ="Source Definition" TOFIELD ="SKU" TOINSTANCE ="SQ_RAW_ITEMS" TOINSTANCETYPE ="Source Qualifier"/>
        <CONNECTOR FROMFIELD ="QTY" FROMINSTANCE ="RAW_ITEMS" FROMINSTANCETYPE ="Source Definition" TOFIELD ="QTY" TOINSTANCE ="SQ_RAW_ITEMS" TOINSTANCETYPE ="Source Qualifier"/>

        <CONNECTOR FROMFIELD ="ID" FROMINSTANCE ="SQ_RAW_ITEMS" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="ID_IN" TOINSTANCE ="EXP_ITEMS" TOINSTANCETYPE ="Expression"/>
        <CONNECTOR FROMFIELD ="SKU" FROMINSTANCE ="SQ_RAW_ITEMS" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="SKU_IN" TOINSTANCE ="EXP_ITEMS" TOINSTANCETYPE ="Expression"/>
        <CONNECTOR FROMFIELD ="QTY" FROMINSTANCE ="SQ_RAW_ITEMS" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="QTY_IN" TOINSTANCE ="EXP_ITEMS" TOINSTANCETYPE ="Expression"/>

        <CONNECTOR FROMFIELD ="ITEM_ID" FROMINSTANCE ="EXP_ITEMS" FROMINSTANCETYPE ="Expression" TOFIELD ="ITEM_ID" TOINSTANCE ="STG_ITEMS" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="PRODUCT_ID" FROMINSTANCE ="EXP_ITEMS" FROMINSTANCETYPE ="Expression" TOFIELD ="PRODUCT_ID" TOINSTANCE ="STG_ITEMS" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="QUANTITY" FROMINSTANCE ="EXP_ITEMS" FROMINSTANCETYPE ="Expression" TOFIELD ="QUANTITY" TOINSTANCE ="STG_ITEMS" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="IS_BULK" FROMINSTANCE ="EXP_ITEMS" FROMINSTANCETYPE ="Expression" TOFIELD ="IS_BULK" TOINSTANCE ="STG_ITEMS" TOINSTANCETYPE ="Target Definition"/>

        <TARGETLOADORDER ORDER ="1" TARGETINSTANCE ="STG_ITEMS"/>
        <ERPINFO/>
    </MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
