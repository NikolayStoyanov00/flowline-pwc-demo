        <INSTANCE NAME ="RTR_REGION" REUSABLE ="NO" TRANSFORMATION_NAME ="RTR_REGION" TRANSFORMATION_TYPE ="Router" TYPE ="TRANSFORMATION"/>
        <INSTANCE NAME ="STG_OTHER_REGIONS" TRANSFORMATION_NAME ="STG_OTHER_REGIONS" TRANSFORMATION_TYPE ="Target Definition" TYPE ="TARGET">
