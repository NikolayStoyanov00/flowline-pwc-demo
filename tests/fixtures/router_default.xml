        <CONNECTOR FROMFIELD ="ID" FROMINSTANCE ="RAW_LOCATIONS" FROMINSTANCETYPE ="Source Definition" TOFIELD ="ID" TOINSTANCE ="SQ_RAW_LOCATIONS" TOINSTANCETYPE ="Source Qualifier"/>
        <CONNECTOR FROMFIELD ="REGION" FROMINSTANCE ="RAW_LOCATIONS" FROMINSTANCETYPE ="Source Definition" TOFIELD ="REGION" TOINSTANCE ="SQ_RAW_LOCATIONS" TOINSTANCETYPE ="Source Qualifier"/>

        <CONNECTOR FROMFIELD ="ID" FROMINSTANCE ="SQ_RAW_LOCATIONS" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="LOCATION_ID" TOINSTANCE ="RTR_REGION" TOINSTANCETYPE ="Router"/>
        <CONNECTOR FROMFIELD ="REGION" FROMINSTANCE ="SQ_RAW_LOCATIONS" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="REGION" TOINSTANCE ="RTR_REGION" TOINSTANCETYPE ="Router"/>

        <CONNECTOR FROMFIELD ="LOCATION_ID2" FROMINSTANCE ="RTR_REGION" FROMINSTANCETYPE ="Router" TOFIELD ="LOCATION_ID" TOINSTANCE ="STG_OTHER_REGIONS" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="REGION2" FROMINSTANCE ="RTR_REGION" FROMINSTANCETYPE ="Router" TOFIELD ="REGION" TOINSTANCE ="STG_OTHER_REGIONS" TOINSTANCETYPE ="Target Definition"/>

        <TARGETLOADORDER ORDER ="1" TARGETINSTANCE ="STG_OTHER_REGIONS"/>
        <ERPINFO/>
    </MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
