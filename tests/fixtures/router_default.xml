<?xml version="1.0" encoding="Windows-1252"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  A Router whose DEFAULT group is connected, which the sample export never
  does. The default group carries no condition of its own: it takes the rows
  that no other group took, including rows where a condition is NULL.

      RAW_LOCATIONS > SQ_RAW_LOCATIONS > RTR_REGION.DEFAULT1 > STG_OTHER_REGIONS

  STG_OTHER_REGIONS.OPENED_AT is written by nothing, to show an unwritten
  target column keeps the target's declared type.
-->
<POWERMART CREATION_DATE="01/01/2026 00:00:00" REPOSITORY_VERSION="187.96">
<REPOSITORY NAME="REPO_RouterDefault" VERSION="187" CODEPAGE="MS1252" DATABASETYPE="Oracle">
<FOLDER NAME="ROUTER_DEFAULT" OWNER="DEV" SHARED="SHARED" PERMISSIONS="rwx---r--">

    <SOURCE DATABASETYPE ="Oracle" DBDNAME ="XEPDB1_RAW" NAME ="RAW_LOCATIONS" OWNERNAME ="RAW" VERSIONNUMBER ="1">
        <SOURCEFIELD DATATYPE ="varchar2" FIELDNUMBER ="1" KEYTYPE ="PRIMARY KEY" NAME ="ID" NULLABLE ="NOTNULL" PRECISION ="100" SCALE ="0"/>
        <SOURCEFIELD DATATYPE ="varchar2" FIELDNUMBER ="2" KEYTYPE ="NOT A KEY" NAME ="REGION" NULLABLE ="NULL" PRECISION ="10" SCALE ="0"/>
    </SOURCE>

    <TARGET DATABASETYPE ="Oracle" NAME ="STG_OTHER_REGIONS" VERSIONNUMBER ="1">
