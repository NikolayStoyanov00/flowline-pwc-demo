        <TARGETFIELD DATATYPE ="varchar2" FIELDNUMBER ="2" KEYTYPE ="NOT A KEY" NAME ="REGION" NULLABLE ="NULL" PRECISION ="10" SCALE ="0"/>
        <TARGETFIELD DATATYPE ="date" FIELDNUMBER ="3" KEYTYPE ="NOT A KEY" NAME ="OPENED_AT" NULLABLE ="NULL" PRECISION ="19" SCALE ="0"/>
    </TARGET>

    <MAPPING ISVALID ="YES" NAME ="m_ROUTER_DEFAULT" OBJECTVERSION ="1" VERSIONNUMBER ="1">

        <TRANSFORMATION NAME ="SQ_RAW_LOCATIONS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Source Qualifier" VERSIONNUMBER ="1">
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="ID" PORTTYPE ="INPUT/OUTPUT" PRECISION ="100" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="varchar2" NAME ="REGION" PORTTYPE ="INPUT/OUTPUT" PRECISION ="10" SCALE ="0"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME ="RTR_REGION" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Router" VERSIONNUMBER ="1">
            <GROUP NAME ="INPUT" ORDER ="1" TYPE ="INPUT"/>
            <GROUP EXPRESSION ="REGION = &apos;APAC&apos;" NAME ="G_APAC" ORDER ="2" TYPE ="OUTPUT"/>
            <GROUP EXPRESSION ="REGION = &apos;EMEA&apos;" NAME ="G_EMEA" ORDER ="3" TYPE ="OUTPUT"/>
            <GROUP NAME ="DEFAULT1" ORDER ="4" TYPE ="OUTPUT/DEFAULT"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="INPUT" NAME ="LOCATION_ID" PORTTYPE ="INPUT" PRECISION ="100" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="INPUT" NAME ="REGION" PORTTYPE ="INPUT" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="G_APAC" NAME ="LOCATION_ID1" PORTTYPE ="OUTPUT" PRECISION ="100" REF_FIELD ="LOCATION_ID" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="G_APAC" NAME ="REGION1" PORTTYPE ="OUTPUT" PRECISION ="10" REF_FIELD ="REGION" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="G_EMEA" NAME ="LOCATION_ID3" PORTTYPE ="OUTPUT" PRECISION ="100" REF_FIELD ="LOCATION_ID" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="G_EMEA" NAME ="REGION3" PORTTYPE ="OUTPUT" PRECISION ="10" REF_FIELD ="REGION" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="DEFAULT1" NAME ="LOCATION_ID2" PORTTYPE ="OUTPUT" PRECISION ="100" REF_FIELD ="LOCATION_ID" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" GROUP ="DEFAULT1" NAME ="REGION2" PORTTYPE ="OUTPUT" PRECISION ="10" REF_FIELD ="REGION" SCALE ="0"/>
        </TRANSFORMATION>

        <INSTANCE DBDNAME ="XEPDB1_RAW" NAME ="RAW_LOCATIONS" TRANSFORMATION_NAME ="RAW_LOCATIONS" TRANSFORMATION_TYPE ="Source Definition" TYPE ="SOURCE"/>
        <INSTANCE NAME ="SQ_RAW_LOCATIONS" REUSABLE ="NO" TRANSFORMATION_NAME ="SQ_RAW_LOCATIONS" TRANSFORMATION_TYPE ="Source Qualifier" TYPE ="TRANSFORMATION">
            <ASSOCIATED_SOURCE_INSTANCE NAME ="RAW_LOCATIONS"/>
