.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# dbt build artefacts (the generated models themselves ARE committed)
target/
dbt_packages/
logs/
*.duckdb
*.duckdb.wal

# dbt writes these on every run
dbt/*/target/
dbt/*/logs/
dbt/*/.user.yml
# convert copies these in from seeds/; no need for a second copy in git
dbt/*/seeds/
